#!/usr/bin/env bash
#
# agi-repl runs agi as a read-eval-print loop: one session, one prompt after
# another, until you quit. agi itself is unchanged and knows nothing about
# this — a repl is a shell holding a directory and calling the same command
# every time, which is what this does and the whole of what it does.
#
#   agi-repl                   # a conversation with the defaults
#   agi-repl -v                # ...with every flag agi takes, passed straight through
#   agi-repl --enable-terminals --max-turns 400
#
# Every run is an ordinary `agi --session DIR` run, so what you see is agi's
# own output and nothing is wrapped, filtered, or re-rendered on the way past.
#
# This is an example, and it sits under examples/ because that is what it is:
# a script written for daily use and kept because it is useful, not a program
# agi ships. It is not production ready and does not try to be. The checks it
# makes are light on purpose — it answers the mistakes somebody actually makes
# and leaves the rest to agi — and the whole of it is short enough to read in
# one sitting and change to suit you. Copy it and make it yours: nothing in
# agi depends on it, and nothing in it is promised to stay as it is.

# No `set -e`: a prompt agi could not answer ends that run and not the repl,
# the way a syntax error ends a statement in a language's repl and not the
# session. `set -u` stays, since every variable here is set by this file.
set -u

# The command to run. An env var rather than a flag because a flag would have
# to be told apart from the flags that belong to agi, and the only reason to
# set it is a build that is not on PATH yet: AGI=./bin/agi agi-repl.
readonly AGI_CMD="${AGI:-agi}"

# The prompt is coloured, and the colour is the one thing on the screen that
# belongs to this script rather than to agi. A repl borrows the terminal it
# was started from, and a prompt that looks like the shell prompt sitting two
# lines above it reads as the shell: the line you type a command at, not a
# question at a model. Magenta says this is somewhere else, and it is bold
# because the prompt is the one thing here that has to be found at a glance
# under a screenful of agi's output that has just scrolled past.
#
# Magenta rather than any other colour because agi's own output has the
# warm end of the palette: tool labels are bold yellow and everything
# subordinate to them is faint. A prompt written in either of those would
# read as one more line agi had printed. And it is one of the sixteen named
# colours, as every colour in agi is, so which magenta this turns out to be
# is the terminal's palette deciding and not a number written down here.
#
# The escapes are wrapped in \001 and \002, which are readline's markers for
# "what lies between these occupies no columns". Readline counts the prompt's
# width to know where the line it is editing begins, and colour it has
# counted as text makes it count wrong, so a long line wraps over itself and
# the cursor sits several characters away from the text it is editing. The
# markers are the whole reason colour is safe here; without them a plain
# prompt would be the better of the two, since a repl whose editing is broken
# is worse than one that is not coloured. The trailing space is left outside
# the colour, so what is painted is the word and not the gap after it.
#
# Nothing is painted when there is nobody to see it. `read` writes its prompt
# to standard error, so that is the stream to ask about, and NO_COLOR and a
# dumb terminal are answered too: the same three questions, in the same
# order, that the color package agi prints through asks itself before it
# writes an escape of its own.
# The line printed before the first prompt is dim, and dim here is what dim is
# in agi: the faint attribute, SGR 2, closed by SGR 22, which is what agi's own
# `--session /tmp/...` line is written in at both ends of a run. The same
# escapes because it is the same kind of line — the program saying where it is
# keeping the work, there to be found rather than read — and saying it in a
# second, nearly-dim of its own would be two conventions on one screen. Faint
# names no color, which is the point of it: the text keeps the terminal's own
# foreground a shade weaker, so a theme that is readable stays readable, where
# a bright black is drawn almost on top of the background in a great many of
# them.
#
# These take no readline markers, unlike the prompt: nothing counts the width
# of a line printf has already finished with.
#
# The prompt is one colour from end to end — the name, the figures beside it,
# and the angle bracket closing it are all the same magenta — and the mark for
# a run that failed is the only thing that breaks the span. Two earlier
# attempts at the figures say why they are not set apart. Faint was the first,
# and the attribute weakens whatever foreground it is given, so beside a bold
# magenta name the one part of the prompt that changes became the one part
# hardest to read. Leaving them unpainted was the second and was worse in its
# own way: a prompt written half in a colour and half in none reads as two
# things that happened to land on the same line, where what is wanted is one
# line that belongs to this script and not to agi.
#
# Red is the exception, and it is the one thing here chosen by convention
# rather than argued for. It is safe for the same reason magenta is: agi
# prints in exactly two styles — bold yellow for a tool label and the faint
# attribute for everything under it, which is the whole of tools/style.go —
# and red is neither, so a mark in it cannot be read as a line agi wrote. It
# is bold because a mark nobody notices is a mark that did not need printing.
if [[ -z ${NO_COLOR:-} && ${TERM:-} != dumb && -t 2 ]]; then
	readonly C_NAME=$'\001\033[1;35m\002'
	readonly C_TROUBLE=$'\001\033[1;31m\002'
	readonly C_OFF=$'\001\033[0m\002'
	readonly DIM=$'\033[2m'
	readonly DIM_OFF=$'\033[22m'
else
	readonly C_NAME=''
	readonly C_TROUBLE=''
	readonly C_OFF=''
	readonly DIM=''
	readonly DIM_OFF=''
fi

usage() {
	cat <<'EOF'
usage: agi-repl [agi flags ...]

Run agi as a repl. Every flag is handed to agi as it is written, on every
prompt of the conversation, so `agi-repl -v` is `agi -v` each time round. The
exceptions are the three this script answers itself: --help is this message,
and --session and --rm are refused, being the repl's own.

The conversation is one session, in a directory this script creates and names
to agi with --session. Enter sends the prompt, and only Enter does: a paste of
several lines is one prompt with newlines in it, whether or not the paste ends
in one, and it waits at the prompt to be edited or added to like anything else
you have typed. The run prints what it always prints, and the prompt comes
back when it is done.

The prompt counts what you have asked, as `#1`, `#2`, and so on, and from the
second one carries how long the last run took and how big the stored
conversation has grown. A run that ended badly is marked before the angle
bracket: `^C` is one you stopped, `!` is one that failed, and `!` with a
number is a status neither of those accounts for.

  Enter                           sends the prompt, however many lines it
                                  has come to be
  Ctrl-V Ctrl-J                   a newline typed on purpose, for a second
                                  line nobody pasted
  Ctrl-C while a run is working   stops that run the way agi stops it: the
                                  conversation is stored and the prompt
                                  comes back
  Ctrl-C or Ctrl-D at the prompt  quits, and says where the session is

This is an example rather than a part of agi: a short script kept because it
is useful, checked lightly, and meant to be read and changed to suit you.
EOF
}

# --session and --rm are the repl's to decide and are refused here rather than
# forwarded. A second --session would quietly replace the directory every
# prompt continues, so the conversation would be split in two with nothing
# said about it; --rm would throw away the session this script just made a
# conversation in. agi would refuse the pair itself, but only on the first
# prompt and in a message about flags the user did not type.
#
# This is a glance at the arguments and not a reading of them, which is the
# weight the job is worth here. It matches the two names as they are written,
# so it does not know that `--` ends the flags and it cannot tell a flag from
# the value of one. Going further would mean keeping a copy of agi's flags in
# this file, to go stale the day one is added, in exchange for catching
# mistakes nobody makes. The mistake somebody does make is typing --session at
# a repl that has just made a session, and that is the one this catches.
# Everything else you mistype is agi's to refuse, on the first prompt and in
# its own words.
for arg in "$@"; do
	case "$arg" in
	-h | --help)
		usage
		exit 0
		;;
	-session | --session | -session=* | --session=* | -rm | --rm)
		printf '%s is the repl'\''s own: the session every prompt continues is this script'\''s to make, to name to agi, and to keep\n' "$arg" >&2
		exit 2
		;;
	esac
done

# A repl needs somebody typing at it. Without a terminal `read -e` has no line
# to edit and the loop would spin through whatever is on standard input as
# fast as it could read it, so say so instead. Standard output is not checked:
# redirecting it is a reasonable thing to do — agi then prints answers alone
# and the prompt still arrives on standard error — and that is a transcript,
# not a mistake.
if [[ ! -t 0 ]]; then
	echo "agi-repl reads what you type: run it at a terminal, or call agi directly with a prompt" >&2
	exit 2
fi

if ! command -v "$AGI_CMD" >/dev/null 2>&1; then
	echo "$AGI_CMD: not found. Build it with 'go install .', or name another one in AGI" >&2
	exit 127
fi

# --session wants a directory that is already there, so this is the mkdir it
# asks for. mktemp -d makes the name unique by creating it, and creates it
# readable by its owner alone, which is what a directory holding a
# conversation should be. It is not removed when the repl ends: the session is
# the work, and the user is told where it is so they can read it or go on with
# it. A conversation nobody wants is `agi --rm` or a deleted directory, and
# both are the user's call to make rather than this script's.
session=$(mktemp -d "${TMPDIR:-/tmp}/agi-repl.XXXXXXXX") || exit 1

# Everything this script says about itself goes to standard error, so that a
# redirected standard output holds the answers and nothing else.
farewell() {
	printf '\n%ssession kept at %s%s\n' "$DIM" "$session" "$DIM_OFF" >&2
	printf '%scontinue it with: %s --session %s "..."%s\n' "$DIM" "$AGI_CMD" "$session" "$DIM_OFF" >&2
}
trap farewell EXIT

# running says whether a run has the terminal, and it is what the Ctrl-C
# handler needs to know. The signal goes to the whole foreground process group
# — agi and this shell both — so one keypress arrives in two places, and what
# it should mean depends on which of them was working:
#
#   during a run   agi has it, and agi's answer to Ctrl-C is a graceful
#                  shutdown, which is the behaviour this script is here to
#                  leave alone. So the handler does nothing at all and the
#                  loop carries on to the next prompt once agi has finished
#                  shutting down. (A second press reaches agi too, and kills
#                  it outright, which is also agi's own behaviour.)
#   at the prompt  nothing else is listening, and Ctrl-C is how you quit.
#
# The trap is installed once and reads the flag, rather than being swapped
# round the run, because a trap set and unset leaves a window where the
# default disposition applies and the keypress kills the shell with agi still
# shutting down. Note that it has to be a handler and never `trap '' INT`:
# ignoring a signal is inherited across exec, so that would take Ctrl-C away
# from agi, which is the one thing here that must keep it.
running=0
on_int() {
	if ((running)); then
		# Bash runs a pending trap only once the foreground command is done,
		# so by the time this is reached agi has already shut down and
		# printed whatever it had to say.
		return
	fi
	exit 0
}
trap on_int INT

# Where the session is, and nothing else. What Enter does and what Ctrl-C does
# are what a repl is, and a person who has opened one has met them in every
# other repl and in the shell this was started from; printed here they would
# be a paragraph read once and scrolled past forever after. --help says it, for
# whoever goes looking.
printf '%sagi repl — session %s%s\n\n' "$DIM" "$session" "$DIM_OFF" >&2

# What the prompt says besides its own name, and why it is only this.
#
# A repl's prompt is the one line always on the screen, so whatever it carries
# is paid for on every line the user types: readline counts those columns, and
# the line being edited begins after them. Three figures earn the room.
#
#   the number   which prompt this is, counting from one. It is this script's
#                count of what has been asked and not agi's count of anything:
#                a conversation's turns are the model's business, and a run
#                that failed outright still happened here.
#   the time     how long the last run took, by this shell's clock rather than
#                by agi's. The two would differ by the cost of starting a
#                process, and this one is here whether or not the run got far
#                enough to write anything down.
#   the size     how big the stored conversation has become. agi counts no
#                tokens anywhere — nothing in it records usage — so there is no
#                honest figure for how full the context is, and the file on
#                disk is the nearest thing there is to one.
#
# A run that ended badly is marked, because the prompt is what comes back
# after a screenful of agi's output has scrolled past and the ending may have
# gone up with it. The two endings agi documents have marks of their own:
# `^C` is a run the user stopped, which is an ordinary thing to do here and so
# is not drawn as a failure, and `!` is a run that failed. Anything else is
# `!` with the status after it, since a status nobody planned for is exactly
# the one worth printing.
#
# Nothing here reads log.jsonl. That file is agi's own account of a run, kept
# for someone inspecting one after the fact, and a prompt that quietly
# depended on it would turn a record into an interface — agi could no longer
# change what it writes there without breaking this. The conversation file is
# asked how many bytes it is and nothing else, which is a question about a
# file rather than about agi's format, and the only honest one this script can
# ask: the snapshot holds what was said and deliberately holds no model, no
# timing, and no count of anything.

# now_ms is the clock a run is timed with. EPOCHREALTIME has the resolution a
# short run needs and arrived in bash 5; SECONDS is in every bash there is and
# counts whole ones, which still answers the only question being asked. The
# decimal point is the locale's, so it is made a dot before the halves are
# taken apart.
if [[ -n ${EPOCHREALTIME:-} ]]; then
	now_ms() {
		local t=${EPOCHREALTIME/,/.}
		printf '%s' "$(( ${t%.*} * 1000 + 10#${t#*.} / 1000 ))"
	}
else
	now_ms() { printf '%s' "$(( SECONDS * 1000 ))"; }
fi

# elapsed renders a duration the way a prompt wants one: short, and to a
# precision that falls away as the number grows, since nobody times a run that
# took three minutes to the tenth of a second.
elapsed() {
	local ms=$1 s=$(( $1 / 1000 ))
	if (( s < 10 )); then
		printf '%d.%ds' "$s" "$(( ms % 1000 / 100 ))"
	elif (( s < 60 )); then
		printf '%ds' "$s"
	else
		printf '%dm%02ds' "$(( s / 60 ))" "$(( s % 60 ))"
	fi
}

# weight renders how big the stored conversation is, and prints nothing until
# there is a kilobyte of it: a conversation that small is not one anyone is
# watching the size of, and a figure reading 0K would be three columns spent
# saying so. The file is the session's snapshot, which does not exist until
# the first run has finished, so the first prompt has no size either.
weight() {
	local file=$session/conversation.json bytes
	[[ -f $file ]] || return
	bytes=$(wc -c <"$file" 2>/dev/null) || return
	bytes=${bytes// /}
	if (( bytes >= 1048576 )); then
		printf '%d.%dM' "$(( bytes / 1048576 ))" "$(( bytes % 1048576 * 10 / 1048576 ))"
	elif (( bytes >= 1024 )); then
		printf '%dK' "$(( bytes / 1024 ))"
	fi
}

# prompt builds the line read shows. It is built every time round rather than
# set once, because every figure in it is about the run that has just
# finished; the name and the angle bracket are all that survive from one
# prompt to the next.
#
# The number wears a # so that it is read as the count it is. Without one it
# sat against the durations and sizes beside it as a fourth figure of the same
# kind, and there is no unit that would tell it apart from them: a prompt
# reading `agi 3 1.2s 12K` offers three numbers and says what two of them are.
prompt() {
	local figures='' mark='' failed='' size

	if [[ -n $last_ms ]]; then
		figures=" $(elapsed "$last_ms")"
	fi
	size=$(weight)
	if [[ -n $size ]]; then
		figures+=" $size"
	fi

	# Only a failure is coloured as one. `^C` is a mark and not a warning: it
	# says what happened to the run above, and the user is the one who made it
	# happen, so it rides the prompt's own colour like the figures do.
	case $last_status in
	0) ;;
	130) mark=' ^C' ;;
	1) mark=' !' failed=1 ;;
	*) mark=" !$last_status" failed=1 ;;
	esac

	# A prompt that reports no failure is one magenta span and no more: the
	# colour is opened once and closed once, rather than being closed and
	# reopened around a mark that does not want the other colour. What that
	# saves is four escapes the terminal would parse every time readline
	# redraws the line, and it is what makes the ordinary prompt the short
	# string it looks like.
	if [[ -n $failed ]]; then
		printf '%s' "${C_NAME}agi #${prompts}${figures}${C_OFF}${C_TROUBLE}${mark}${C_OFF}${C_NAME}>${C_OFF} "
	else
		printf '%s' "${C_NAME}agi #${prompts}${figures}${mark}>${C_OFF} "
	fi
}

# What ends a prompt, and it is the Enter key rather than a newline. The two
# are not the same thing, which is the whole of what this line is about: Enter
# sends the carriage return a terminal has always sent for that key, and the
# newlines inside a paste are the shape of what was copied. Reading to the
# first newline makes a paste of five lines into one prompt and four lines
# typed at prompts nobody meant to answer; reading to the carriage return
# makes it one prompt that happens to have newlines in it, and leaves the
# sending to the key that means send.
#
# `read -e -d` is what makes the difference reachable from a script. The read
# builtin stops at the first character of the delimiter it is given, and when
# it is editing with readline it takes the line readline hands back whole and
# appends that delimiter to it — so a buffer with newlines in the middle
# arrives with the newlines still in it, and the read ends where Enter put the
# return. With the default delimiter the same buffer is cut at its first
# newline and the rest of it is dropped before this script ever sees it, which
# is the one way a repl built on `read` loses a paste.
#
# One thing the distinction does not reach is a line typed while a run is
# working. The terminal belongs to agi then rather than to readline, and the
# kernel turns that Return into a newline on its way into the queue; readline
# reads back the newline it has become and ends the line there. So typing
# ahead sends on its own, as it always did here. It is the one place a newline
# still means send, and it means it because by the time anything here could
# look there is nothing left to tell it from one.
readonly SEND=$'\r'

# Bracketed paste does the other half, and it is readline's own: the terminal
# wraps a paste in markers, readline puts everything between them into the
# line being edited without running any of it as a keypress, and so a newline
# in a paste is text and a tab in one stays a tab instead of completing a
# filename. It is the default in readline 8.1 and after, and it is asked for
# here anyway — a repl that reads to the Enter key is built on the terminal
# saying which newlines came from a paste, and that is the setting that makes
# it say so. The binding is made before line editing exists, so bash warns
# that there is none and keeps the setting for the first `read -e`; the
# warning is dropped, and a readline too old to have heard of bracketed paste
# reads a typed line exactly as it did before.
bind 'set enable-bracketed-paste on' 2>/dev/null

# read_prompt reads one prompt into `line`: the line that was typed, the block
# that was pasted, or both. It answers false when input is over, as `read`
# does, being one read and nothing else.
#
#   -r    a backslash is a character the model is shown rather than an escape
#         this shell eats.
#   -e    readline: line editing, and the arrow keys over what has been asked
#         so far.
#   -d    the Enter key, for the reason SEND is above it.
#   IFS=  the indentation of a pasted line is the model's to see rather than
#         this shell's to trim.
read_prompt() {
	IFS= read -r -e -d "$SEND" -p "$(prompt)" line
}

# The state the prompt is drawn from, and the whole of what this script
# remembers between runs. last_ms is empty until a run has been timed, which
# is what keeps the first prompt from reporting a duration it does not have.
prompts=1
last_ms=''
last_status=0

while true; do
	if ! read_prompt; then
		# End of input: Ctrl-D, which quits like Ctrl-C does. (An interrupt
		# ends the read too, and the handler above has already quit by the
		# time this would be reached.)
		exit 0
	fi

	# A blank line is somebody pressing Enter, not a prompt with nothing in
	# it, so ask again. agi refuses an empty prompt anyway; this keeps the
	# refusal off the screen.
	if [[ -z ${line//[[:space:]]/} ]]; then
		continue
	fi

	# What was typed goes into the history list, which is what readline reads
	# the arrow keys against. Only non-empty lines, and the list lives as long
	# as the repl does: this is editing, not a record of the conversation —
	# the session and its log are that, and they are agi's to write.
	#
	# A pasted block goes in whole, newlines and all, and comes back the same
	# way: readline shows it as the several lines it is and the read above
	# ends where Enter ends it, so what the arrow key offers is what gets
	# sent. That is the same property the delimiter buys, met from the other
	# side.
	history -s -- "$line"

	# --session is what makes this one conversation rather than a series of
	# unrelated runs: the same directory every time, so each prompt is
	# appended to what has been said and the model is shown the whole
	# exchange. The user's flags follow it, and the prompt goes last after
	# `--`, because it is text and not a flag — a question that begins with a
	# hyphen is still a question.
	#
	# Giving --session is also what keeps agi from naming the directory at
	# both ends of every run, which it does when it chose the directory
	# itself. Nothing here asks for that: a run told where to go is told
	# where it is by whoever told it, and this script says so before the
	# first prompt and again on the way out.
	#
	# The status and the clock are read the moment the run is over, before
	# anything else here can set either. Bash saves and restores $? around a
	# trap handler, so the pending Ctrl-C handler running between these two
	# lines does not stand where the run's own status should be.
	running=1
	started=$(now_ms)
	"$AGI_CMD" --session "$session" "$@" -- "$line"
	last_status=$?
	last_ms=$(( $(now_ms) - started ))
	running=0

	(( prompts += 1 ))

	printf '\n' >&2
done
